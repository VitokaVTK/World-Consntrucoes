@model IReadOnlyList<ApplicationUser>
@{
    ViewData["Title"] = "Corretores";
}
<section class="container portal-page">
    <a asp-action="Index" class="back-link">← Painel</a>
    <div class="portal-heading"><div><span class="eyebrow">EQUIPE</span><h1>Corretores</h1><p>Somente o administrador cria e gerencia contas de corretor.</p></div></div>
    @if (ViewBag.Created is string created) { <div class="alert alert-success">@created</div> }
    @if (ViewBag.CreateError is string error) { <div class="alert alert-danger">@error</div> }
    <div class="portal-columns">
        <section class="panel"><h2>Cadastrar corretor</h2><form asp-action="CreateBroker" method="post" class="stack-form">
            <label>Nome completo<input name="FullName" required maxlength="120" /></label><label>E-mail<input name="Email" type="email" required /></label><label>Telefone<input name="Phone" type="tel" /></label><label>Senha temporária<input name="TemporaryPassword" type="password" required minlength="8" /></label>
            <button class="btn btn-accent">Criar conta</button>
        </form></section>
        <section class="panel"><h2>Corretores cadastrados</h2>
            @if (Model.Count == 0) { <p class="muted">Nenhum corretor cadastrado ainda.</p> }
            else { @foreach (var broker in Model) { <div class="lead-row"><span class="avatar">@broker.FullName[..1].ToUpperInvariant()</span><span><strong>@broker.FullName</strong><small>@broker.Email · @broker.PhoneNumber</small></span></div> } }
        </section>
    </div>
</section>