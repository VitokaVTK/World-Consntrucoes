@model RegisterInput
@{
    ViewData["Title"] = "Criar conta";
}
<section class="auth-page container">
    <div class="auth-card"><span class="eyebrow">ÁREA DO CLIENTE</span><h1>Crie sua conta</h1><p>Cadastre-se para acompanhar seus imóveis e conversas.</p>
        <form asp-action="Register" method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="FullName">Nome completo<input asp-for="FullName" autocomplete="name" /></label><span asp-validation-for="FullName" class="text-danger"></span>
            <label asp-for="Email">E-mail<input asp-for="Email" type="email" autocomplete="email" /></label><span asp-validation-for="Email" class="text-danger"></span>
            <label asp-for="Phone">Telefone<input asp-for="Phone" type="tel" autocomplete="tel" /></label><span asp-validation-for="Phone" class="text-danger"></span>
            <label asp-for="Password">Senha<input asp-for="Password" autocomplete="new-password" /></label><span asp-validation-for="Password" class="text-danger"></span>
            <label asp-for="ConfirmPassword">Confirme a senha<input asp-for="ConfirmPassword" autocomplete="new-password" /></label><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <button class="btn btn-accent w-100">Criar conta</button>
        </form>
        <p class="auth-foot">Já possui cadastro? <a asp-action="Login">Entrar</a></p>
    </div>
</section>